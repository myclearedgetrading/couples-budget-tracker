# Neon Postgres connection string (server-only).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Neon Managed Better Auth URL from the Neon Console Auth page.
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.REGION.aws.neon.tech/neondb/auth

# Generate a private random value of at least 32 characters.
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEON_AUTH_COOKIE_SECRET=

# Public Auth and Data API URLs for browser clients.
NEXT_PUBLIC_NEON_AUTH_URL=https://ep-xxxx.neonauth.REGION.aws.neon.tech/neondb/auth
NEXT_PUBLIC_NEON_DATA_API_URL=https://ep-xxxx.apirest.REGION.aws.neon.tech/neondb/rest/v1

# Optional: emailed partner invitations and reminders.
RESEND_API_KEY=
RESEND_FROM_EMAIL=budget@example.com

# Optional future billing integration.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
